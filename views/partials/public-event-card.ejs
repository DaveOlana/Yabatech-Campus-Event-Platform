<article class="public-event-card"><a class="public-event-card__poster" href="/events/<%= event.id %>" aria-label="View <%= event.title %>"><% if(event.posterUrl){ %><img src="<%= event.posterUrl %>" alt="Poster for <%= event.title %>" loading="lazy" data-poster-image><% } %><div class="poster-fallback" data-poster-fallback <%= event.posterUrl ? 'hidden' : '' %>><span><%= event.category.name %></span><strong><%= event.title %></strong></div></a><div class="public-event-card__body"><span class="public-event-card__category"><%= event.category.name %></span><h3><a href="/events/<%= event.id %>"><%= event.title %></a></h3><p class="public-event-card__description"><%= event.description %></p><dl class="public-event-card__meta"><div><dt>Date</dt><dd><%= formatEventCardDate(event.eventDate) %> · <%= formatEventTimeRange(event.startTime,event.endTime) %></dd></div><div><dt>Venue</dt><dd><%= event.venue %></dd></div></dl><p class="public-event-card__organizer">By <%= event.organizerPublicName %></p></div></article>
