<section class="form-section">
  <div class="form-section__heading"><span>01</span><div><h2>Event information</h2><p>Give Management a clear, public-ready description.</p></div></div>
  <div class="form-grid form-grid--2">
    <div class="form-group"><label for="title">Title</label><input id="title" name="title" value="<%= values.title || '' %>" required maxlength="200"><% if(errors.title){ %><div class="field-error"><%= errors.title %></div><% } %></div>
    <div class="form-group"><label for="categoryId">Category</label><select id="categoryId" name="categoryId" required><option value="">Select a category</option><% categories.forEach(function(category){ %><option value="<%= category.id %>" <%= values.categoryId===category.id?'selected':'' %>><%= category.name %></option><% }) %></select><% if(errors.categoryId){ %><div class="field-error"><%= errors.categoryId %></div><% } %></div>
  </div>
  <div class="form-group"><label for="description">Description</label><textarea id="description" name="description" rows="7" required maxlength="5000"><%= values.description || '' %></textarea><% if(errors.description){ %><div class="field-error"><%= errors.description %></div><% } %></div>
  <div class="event-media-fields">
    <div class="form-group poster-upload-field" data-poster-upload data-direct-upload="<%= directPosterUploads ? 'true' : 'false' %>">
      <label for="poster">Event poster or flyer <span class="muted">Optional</span></label>
      <p class="helper-text">For the best fit, use a 4:5 poster (recommended: 1080 × 1350 px). JPEG, PNG, and WebP images up to 4 MB are accepted, and other shapes are shown in full without cropping.</p>
      <label class="poster-upload-control" for="poster"><span>Choose poster</span><small data-poster-file-name>No file selected</small></label>
      <input id="poster" name="poster" type="file" accept="image/jpeg,image/png,image/webp" data-poster-input>
      <input type="hidden" name="posterUrl" value="" data-poster-url>
      <input type="hidden" name="posterBlobPath" value="" data-poster-blob-path>
      <p class="helper-text" data-poster-upload-status aria-live="polite"></p>
      <div class="poster-upload-preview" data-poster-preview <%= typeof event !== 'undefined' && event.posterUrl ? '' : 'hidden' %>><% if(typeof event !== 'undefined' && event.posterUrl){ %><img src="<%= event.posterUrl %>" alt="Current poster for <%= event.title %>" data-poster-preview-image><% } else { %><img alt="Selected poster preview" data-poster-preview-image hidden><% } %></div>
      <% if(typeof event !== 'undefined' && event.posterUrl){ %><label class="poster-remove"><input type="checkbox" name="removePoster" value="on" data-poster-remove> Remove the current poster</label><% } %>
      <% if(errors.poster){ %><div class="field-error"><%= errors.poster %></div><% } %>
    </div>
    <div class="form-group registration-link-field">
      <label for="registrationUrl">Registration link <span class="muted">Optional</span></label>
      <p class="helper-text">Add the secure external page people should use to register. Management will inspect it before publication.</p>
      <input id="registrationUrl" name="registrationUrl" type="url" inputmode="url" value="<%= values.registrationUrl || '' %>" placeholder="https://example.com/register" maxlength="1000">
      <% if(errors.registrationUrl){ %><div class="field-error"><%= errors.registrationUrl %></div><% } %>
    </div>
  </div>
</section>
<section class="form-section">
  <div class="form-section__heading"><span>02</span><div><h2>Schedule &amp; venue</h2><p>Set the public event time and location.</p></div></div>
  <div class="form-grid form-grid--3">
    <div class="form-group"><label for="eventDate">Date</label><input id="eventDate" name="eventDate" type="date" value="<%= values.eventDate || '' %>" required><% if(errors.eventDate){ %><div class="field-error"><%= errors.eventDate %></div><% } %></div>
    <div class="form-group"><label for="startTime">Start</label><input id="startTime" name="startTime" type="time" value="<%= values.startTime || '' %>" required><% if(errors.startTime){ %><div class="field-error"><%= errors.startTime %></div><% } %></div>
    <div class="form-group"><label for="endTime">End</label><input id="endTime" name="endTime" type="time" value="<%= values.endTime || '' %>" required><% if(errors.endTime){ %><div class="field-error"><%= errors.endTime %></div><% } %></div>
  </div>
  <div class="form-group"><label for="venue">Venue</label><input id="venue" name="venue" value="<%= values.venue || '' %>" required maxlength="200"><% if(errors.venue){ %><div class="field-error"><%= errors.venue %></div><% } %></div>
</section>
<section class="form-section">
  <div class="form-section__heading"><span>03</span><div><h2>Recommended audience</h2><p>These choices support discovery and never restrict public visibility.</p></div></div>
  <div class="form-grid form-grid--2">
    <fieldset><legend>Departments</legend><%- include('department-picker', { id: 'targetDepartmentIds', name: 'targetDepartmentIds', departments, valueKey: 'id', selectedValue: values.targetDepartmentIds, placeholder: 'Choose target departments', searchPlaceholder: 'Search target departments', multiple: true, required: false, showCode: false, errorClass: errors.targetDepartmentIds ? 'input-error' : '' }) %><p class="helper-text department-picker__help">Choose any number of relevant departments. Leave empty for a general campus event.</p></fieldset>
    <fieldset><legend>Levels</legend><div class="multi-choice-actions" data-checklist-actions="targetLevelIds"><button type="button" data-select-all>Select all</button><button type="button" data-clear-all>Clear</button></div><% levels.forEach(function(level){ const selected=values.targetLevelIds&&values.targetLevelIds.includes(level.id); %><label><input type="checkbox" name="targetLevelIds" value="<%= level.id %>" <%= selected?'checked':'' %>> <%= level.code %> &mdash; <%= level.label %></label><% }) %></fieldset>
  </div>
  <div class="department-suggestion" id="department-suggestion"><h3>Department not listed?</h3><p class="helper-text">Suggest one for this event. It becomes an official filter only if YABATECH Management approves the event.</p><div class="form-grid form-grid--2"><div class="form-group"><label for="suggestedDepartmentName">Department name</label><input id="suggestedDepartmentName" name="suggestedDepartmentName" maxlength="120" value="<%= values.suggestedDepartmentName || '' %>" placeholder="e.g. Aerospace Engineering"><% if(errors.suggestedDepartmentName){ %><p class="field-error"><%= errors.suggestedDepartmentName %></p><% } %></div><div class="form-group"><label for="suggestedDepartmentCode">Short code</label><input id="suggestedDepartmentCode" name="suggestedDepartmentCode" maxlength="12" value="<%= values.suggestedDepartmentCode || '' %>" placeholder="e.g. ASE"><% if(errors.suggestedDepartmentCode){ %><p class="field-error"><%= errors.suggestedDepartmentCode %></p><% } %></div></div></div>
</section>
