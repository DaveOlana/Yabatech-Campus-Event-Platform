<section class="form-section"><div class="form-section__heading"><span>01</span><div><h2>Event information</h2><p>Give Management a clear, public-ready description.</p></div></div><div class="form-grid form-grid--2"><div class="form-group"><label for="title">Title</label><input id="title" name="title" value="<%= values.title || '' %>" required maxlength="200"><% if(errors.title){ %><div class="field-error"><%= errors.title %></div><% } %></div><div class="form-group"><label for="categoryId">Category</label><select id="categoryId" name="categoryId" required><option value="">Select a category</option><% categories.forEach(function(category){ %><option value="<%= category.id %>" <%= values.categoryId===category.id?'selected':'' %>><%= category.name %></option><% }) %></select><% if(errors.categoryId){ %><div class="field-error"><%= errors.categoryId %></div><% } %></div></div><div class="form-group"><label for="description">Description</label><textarea id="description" name="description" rows="7" required maxlength="5000"><%= values.description || '' %></textarea><% if(errors.description){ %><div class="field-error"><%= errors.description %></div><% } %></div><div class="form-group"><label for="posterUrl">Poster URL <span class="muted">Optional</span></label><input id="posterUrl" name="posterUrl" type="url" value="<%= values.posterUrl || '' %>" placeholder="https://example.com/poster.jpg"><% if(errors.posterUrl){ %><div class="field-error"><%= errors.posterUrl %></div><% } %></div></section>
<section class="form-section"><div class="form-section__heading"><span>02</span><div><h2>Schedule &amp; venue</h2><p>Set the public event time and location.</p></div></div><div class="form-grid form-grid--3"><div class="form-group"><label for="eventDate">Date</label><input id="eventDate" name="eventDate" type="date" value="<%= values.eventDate || '' %>" required><% if(errors.eventDate){ %><div class="field-error"><%= errors.eventDate %></div><% } %></div><div class="form-group"><label for="startTime">Start</label><input id="startTime" name="startTime" type="time" value="<%= values.startTime || '' %>" required><% if(errors.startTime){ %><div class="field-error"><%= errors.startTime %></div><% } %></div><div class="form-group"><label for="endTime">End</label><input id="endTime" name="endTime" type="time" value="<%= values.endTime || '' %>" required><% if(errors.endTime){ %><div class="field-error"><%= errors.endTime %></div><% } %></div></div><div class="form-group"><label for="venue">Venue</label><input id="venue" name="venue" value="<%= values.venue || '' %>" required maxlength="200"><% if(errors.venue){ %><div class="field-error"><%= errors.venue %></div><% } %></div></section>
<section class="form-section"><div class="form-section__heading"><span>03</span><div><h2>Recommended audience</h2><p>These choices support future discovery and never restrict public visibility.</p></div></div><div class="form-grid form-grid--2"><fieldset><legend>Departments</legend><% departments.forEach(function(department){ const selected=values.targetDepartmentIds&&values.targetDepartmentIds.includes(department.id); %><label><input type="checkbox" name="targetDepartmentIds" value="<%= department.id %>" <%= selected?'checked':'' %>> <%= department.name %></label><% }) %></fieldset><fieldset><legend>Levels</legend><% levels.forEach(function(level){ const selected=values.targetLevelIds&&values.targetLevelIds.includes(level.id); %><label><input type="checkbox" name="targetLevelIds" value="<%= level.id %>" <%= selected?'checked':'' %>> <%= level.code %> — <%= level.label %></label><% }) %></fieldset></div></section>
