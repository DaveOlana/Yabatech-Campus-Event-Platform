<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=2"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=2"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=2"><link rel="shortcut icon" href="/favicon.ico?v=2"><link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/public-header') %>
  <header>
    <h1>YABATECH Campus Events Platform</h1>
  </header>
  <main>
    <div class="alert-success">
      <h2>Registration Successful!</h2>
      <p>Welcome, <strong><%= user.fullName %></strong>.</p>
      <p>Your member account has been created and your verification status for the current academic cycle is <strong><%= verification.status %></strong>.</p>
    </div>

    <section>
      <h3>Account Details</h3>
      <p><strong>Matric Number:</strong> <%= user.matricNumber %></p>
      <p><strong>Email:</strong> <%= user.email %></p>
      <p><strong>Verification Status:</strong> <%= verification.status %></p>
      <% if (verification.expiresAt) { %>
        <p><strong>Cycle Expiry:</strong> <%= new Date(verification.expiresAt).toLocaleDateString() %></p>
      <% } %>
    </section>

    <div style="display: flex; gap: 1rem; margin-top: 1.5rem; align-items: center;">
      <a href="/login" class="btn-primary" style="padding: 0.6rem 1.25rem;">Sign In to Your Account</a>
      <a href="/">Return to Home</a>
    </div>
  </main>
  <footer>
    <p>&copy; <%= new Date().getFullYear() %> YABATECH Campus Events Platform</p>
  </footer>
</body>
</html>
