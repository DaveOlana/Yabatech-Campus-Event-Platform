<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg?v=3"><link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=3"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=3"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=3"><link rel="shortcut icon" href="/favicon.ico?v=3"><link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/member-header') %>
  <header>
    <h1>YABATECH Campus Events Platform</h1>
  </header>
  <main>
    <div class="alert-success">
      <h2>Protected Action Granted</h2>
      <p>Hello <strong><%= user.fullName %></strong>. You have successfully accessed a protected action that requires an active verification for the current academic cycle.</p>
    </div>

    <% if (verification) { %>
      <p>Verified status: <strong><%= verification.status %></strong></p>
    <% } %>

    <p style="margin-top: 1.5rem;">
      <a href="/account">Back to My Account</a>
    </p>
  </main>
  <footer>
    <p>&copy; <%= new Date().getFullYear() %> YABATECH Campus Events Platform</p>
  </footer>
</body>
</html>
