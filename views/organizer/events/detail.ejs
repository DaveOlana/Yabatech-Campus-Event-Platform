<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('../../partials/member-header') %><main class="container"><p><a href="/organizer/events">← My events</a></p><div class="page-header"><div><span class="badge badge-<%= event.status.toLowerCase().replace('_','-') %>"><%= event.status.replace('_',' ') %></span><h1><%= event.title %></h1><p class="muted">Presented by <%= event.organizerPublicName %></p></div><% if(event.status==='DRAFT'){ %><div class="actions"><a class="btn-secondary" href="/organizer/events/<%= event.id %>/edit">Edit draft</a><form method="POST" action="/organizer/events/<%= event.id %>/submit"><button type="submit">Submit for review</button></form></div><% } %></div>
<% if(event.status==='PENDING_APPROVAL'){ %><div class="notice notice-info">Editing is locked while YABATECH Management reviews this event.</div><% } %><% if(event.status==='REJECTED'){ %><div class="alert-error"><h2>Management feedback</h2><p><%= event.rejectionReason %></p><p>This event is preserved and cannot be edited or resubmitted.</p></div><% } %>
<% if(event.posterUrl){ %><img src="<%= event.posterUrl %>" alt="Poster for <%= event.title %>" style="width:100%;max-height:440px;object-fit:cover;border-radius:14px;margin-bottom:1.5rem"><% } %>
<section class="card"><h2>About this event</h2><p><%= event.description %></p><dl class="detail-grid"><div class="detail-item"><dt>Category</dt><dd><%= event.category.name %></dd></div><div class="detail-item"><dt>Venue</dt><dd><%= event.venue %></dd></div><div class="detail-item"><dt>Date</dt><dd><%= new Date(event.eventDate).toLocaleDateString('en-NG',{dateStyle:'long',timeZone:'UTC'}) %></dd></div><div class="detail-item"><dt>Time</dt><dd><%= event.startTime %>–<%= event.endTime %> WAT</dd></div><div class="detail-item"><dt>Departments</dt><dd><%= event.targetDepartments.length?event.targetDepartments.map(td=>td.department.name).join(', '):'All departments' %></dd></div><div class="detail-item"><dt>Levels</dt><dd><%= event.targetLevels.length?event.targetLevels.map(tl=>tl.level.code).join(', '):'All levels' %></dd></div></dl></section></main><%- include('../../partials/footer') %></body></html>
