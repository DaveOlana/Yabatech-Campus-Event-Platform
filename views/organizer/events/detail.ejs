<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png"><link rel="shortcut icon" href="/favicon.ico"><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <%- include('../../partials/member-header') %>
  <main class="container">
    <p><a href="/organizer/events">&larr; My events</a></p>
    <div class="page-header"><div><span class="badge badge-<%= event.status.toLowerCase().replace('_','-') %>"><%= event.status.replace('_',' ') %></span><h1><%= event.title %></h1><p class="muted">Presented by <%= event.organizerPublicName %></p></div><% if(event.status==='DRAFT'){ %><div class="actions"><a class="btn-secondary" href="/organizer/events/<%= event.id %>/edit">Edit draft</a><form method="POST" action="/organizer/events/<%= event.id %>/submit"><%- include('../../partials/csrf-field') %><button type="submit">Submit for review</button></form></div><% } else if(event.status==='REJECTED'){ %><div class="actions"><a class="btn-primary" href="/organizer/events/<%= event.id %>/edit">Revise event</a></div><% } %></div>
    <% if(event.status==='PENDING_APPROVAL'){ %><div class="notice notice-info">Editing is locked while YABATECH Management reviews this event.</div><% } %>
    <% if(event.status==='PUBLISHED'){ %><div class="notice notice-info">This approved event is published and cannot be edited. If it can no longer proceed, cancel it below.</div><% } %>
    <% if(event.status==='REJECTED'){ %><div class="alert-error"><h2>Management feedback</h2><p><%= event.rejectionReason %></p><p>Revise the event using this feedback, save it as a draft, and submit it for a new Management review.</p></div><% } else if(event.status==='DRAFT' && event.rejectionReason){ %><div class="notice notice-warning"><h2>Previous Management feedback</h2><p><%= event.rejectionReason %></p><p>Your revision is now a private draft. Submit it when the requested changes are complete.</p></div><% } %>
    <% if(event.status==='CANCELLED'){ %><div class="notice notice-warning"><h2>Event cancelled</h2><p><%= event.cancellationReason %></p><p>Cancelled <%= event.cancelledAt?new Date(event.cancelledAt).toLocaleString('en-NG'):'—' %>. This historical record cannot be edited.</p></div><% } %>
    <% if(event.posterUrl){ %><div class="poster-frame poster-frame--workflow"><img src="<%= event.posterUrl %>" alt="Poster for <%= event.title %>" class="workflow-poster" referrerpolicy="no-referrer"></div><% } %>
    <section class="card"><h2>About this event</h2><p><%= event.description %></p><dl class="detail-grid"><div class="detail-item"><dt>Category</dt><dd><%= event.category.name %></dd></div><div class="detail-item"><dt>Venue</dt><dd><%= event.venue %></dd></div><div class="detail-item"><dt>Date</dt><dd><%= new Date(event.eventDate).toLocaleDateString('en-NG',{dateStyle:'long',timeZone:'UTC'}) %></dd></div><div class="detail-item"><dt>Time</dt><dd><%= event.startTime %>&ndash;<%= event.endTime %> WAT</dd></div><div class="detail-item"><dt>Registration link</dt><dd><% if(event.registrationUrl){ %><a href="<%= event.registrationUrl %>" target="_blank" rel="noopener noreferrer"><%= event.registrationUrl %> <span aria-hidden="true">&nearr;</span></a><% } else { %>Not provided<% } %></dd></div><div class="detail-item"><dt>Departments</dt><dd><%= event.targetDepartments.length?event.targetDepartments.map(td=>td.department.name).join(', '):'All departments' %></dd></div><div class="detail-item"><dt>Levels</dt><dd><%= event.targetLevels.length?event.targetLevels.map(tl=>tl.level.code).join(', '):'All levels' %></dd></div></dl></section>
    <% if(event.status==='PUBLISHED'){ %><section class="card cancellation-panel"><h2>Cancel this event</h2><p class="muted">Cancellation is permanent. The event will leave public discovery but its direct page will explain the cancellation.</p><form method="POST" action="/organizer/events/<%= event.id %>/cancel"><%- include('../../partials/csrf-field') %><div class="form-group"><label for="cancellationReason">Public cancellation reason</label><textarea id="cancellationReason" name="cancellationReason" minlength="10" maxlength="500" required aria-describedby="cancelHelp"></textarea><div id="cancelHelp" class="helper-text">This reason will be shown publicly on the event page. Do not include private or personal information.</div></div><button class="btn-danger" type="submit">Cancel event</button></form></section><% } %>
  </main>
  <%- include('../../partials/footer') %>
  <script src="/js/event-form-recovery.js" defer></script>
</body>
</html>
