<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg?v=3"><link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=3"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=3"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=3"><link rel="shortcut icon" href="/favicon.ico?v=3"><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <%- include('../../partials/member-header') %>
  <main class="main-wide">
    <p><a href="/organizer/events/<%= event.id %>">&larr; Draft details</a></p>
    <div class="page-header"><div><span class="eyebrow"><%= event.status==='REJECTED'?'Revision requested':'Draft editor' %></span><h1><%= event.status==='REJECTED'?'Revise event':'Edit event' %></h1><p><%= event.status==='REJECTED'?'Address Management feedback, then save the event as a new private draft.':'Refine the proposal before sending it to Management.' %></p></div></div>
    <% if(event.status==='REJECTED' && event.rejectionReason){ %><div class="alert-error"><h2>Management feedback</h2><p><%= event.rejectionReason %></p></div><% } %>
    <% if(errorMessage){ %><div class="alert-error"><%= errorMessage %></div><% } %>
    <aside class="draft-recovery" data-draft-recovery hidden><div><strong>Unsaved changes restored</strong><p data-draft-recovery-message>Your event details were restored automatically from this browser tab.</p></div><div class="actions"><button type="button" class="btn-ghost btn-sm" data-draft-discard>Discard recovered changes</button></div></aside>
    <form class="publishing-form" method="POST" action="/organizer/events/<%= event.id %>" enctype="multipart/form-data" novalidate data-event-draft-form data-event-draft-key="<%= event.id %>">
      <%- include('../../partials/csrf-field') %>
      <%- include('../../partials/event-form-fields') %>
      <p class="form-recovery-status" data-draft-recovery-status aria-live="polite">Event details are kept in this browser tab while you work.</p>
      <div class="form-actions"><a class="btn-ghost" href="/organizer/events/<%= event.id %>" data-draft-abandon>Cancel</a><button type="submit">Save changes</button></div>
    </form>
  </main>
  <%- include('../../partials/footer') %>
  <script src="/js/poster-upload.js" defer></script>
  <script src="/js/poster-direct-upload.js" defer></script>
  <script src="/js/event-form-recovery.js" defer></script>
</body>
</html>
