<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=4"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=4"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=4"><link rel="shortcut icon" href="/favicon.ico?v=4"><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <%- include('../../partials/member-header') %>
  <main class="main-wide">
    <div class="page-header"><div class="page-header__copy"><span class="eyebrow">Organizer workspace</span><h1>My Events</h1><p>Create, submit, and follow campus event proposals for <strong><%= authorization.approvedPublicName %></strong>.</p></div><a class="btn-primary" href="/organizer/events/new">Create event</a></div>
    <nav class="event-view-tabs" aria-label="Event views"><% const tabs=[['all','All'],['drafts','Drafts'],['pending','Pending'],['published','Published'],['rejected','Rejected'],['history','History']]; tabs.forEach(function(tab){ %><a href="<%= tab[0]==='all'?'/organizer/events':'/organizer/events?view='+tab[0] %>" class="<%= view===tab[0]?'is-active':'' %>" <%- view===tab[0]?'aria-current="page"':'' %>><%= tab[1] %></a><% }) %></nav>
    <% if(events.length){ %>
      <div class="event-workspace">
        <% events.forEach(function(event){ const statusClass=event.status.toLowerCase().replace('_','-'); const timeState=event.status==='PUBLISHED'?getEventTimeState(event.eventDate,event.startTime,event.endTime):null; %>
          <article class="event-row">
            <% if(event.posterUrl){ %><img class="event-row__poster" src="<%= event.posterUrl %>" alt="" referrerpolicy="no-referrer"><% } else { %><div class="event-row__date"><strong><%= new Date(event.eventDate).toLocaleDateString('en-NG',{day:'2-digit',timeZone:'UTC'}) %></strong><span><%= new Date(event.eventDate).toLocaleDateString('en-NG',{month:'short',timeZone:'UTC'}) %></span></div><% } %>
            <div class="event-row__content"><div class="event-row__heading"><div><h2><a href="/organizer/events/<%= event.id %>"><%= event.title %></a></h2><p><%= event.category.name %> &middot; <%= event.venue %><% if(event.registrationUrl){ %> &middot; External registration<% } %></p></div><div class="event-row__badges"><span class="badge badge-<%= statusClass %>"><%= event.status.replace('_',' ') %></span><% if(timeState){ %><span class="time-state time-state--<%= timeState %>"><%= timeState==='past'?'Past event':timeState==='live'?'Happening now':'Upcoming' %></span><% } %></div></div><p class="event-row__meta">Updated <%= new Date(event.updatedAt).toLocaleDateString('en-NG',{dateStyle:'medium'}) %><% if(event.submittedAt){ %> &middot; Submitted <%= new Date(event.submittedAt).toLocaleDateString('en-NG',{dateStyle:'medium'}) %><% } %></p></div>
            <div class="event-row__actions"><a class="btn-secondary btn-sm" href="/organizer/events/<%= event.id %>">View</a><% if(event.status==='DRAFT'){ %><a class="btn-ghost btn-sm" href="/organizer/events/<%= event.id %>/edit">Edit</a><form method="POST" action="/organizer/events/<%= event.id %>/submit"><button class="btn-primary btn-sm" type="submit">Submit</button></form><% } else if(event.status==='REJECTED'){ %><a class="btn-primary btn-sm" href="/organizer/events/<%= event.id %>/edit">Revise</a><% } %></div>
          </article>
        <% }) %>
      </div>
    <% } else { %><div class="empty-state"><h2>No events in this view</h2><p><%= view==='all'?'Start by creating your first event. Drafts stay private until submitted to Management.':'Try another event view or create a new draft.' %></p><% if(view==='all'||view==='drafts'){ %><a class="btn-primary" href="/organizer/events/new">Create event</a><% } %></div><% } %>
  </main>
  <%- include('../../partials/footer') %>
</body>
</html>
