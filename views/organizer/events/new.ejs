<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <%- include('../../partials/member-header') %>
  <main class="main-wide">
    <p><a href="/organizer/events">&larr; My events</a></p>
    <div class="page-header"><div><span class="eyebrow">New proposal</span><h1>Create an event</h1><p>Prepare a private draft as <strong><%= authorization.approvedPublicName %></strong>. You can review everything before submission.</p></div></div>
    <% if(errorMessage){ %><div class="alert-error"><%= errorMessage %></div><% } %>
    <aside class="draft-recovery" data-draft-recovery hidden><div><strong>Unsaved changes restored</strong><p data-draft-recovery-message>Your event details were restored automatically from this browser tab.</p></div><div class="actions"><button type="button" class="btn-ghost btn-sm" data-draft-discard>Discard recovered changes</button></div></aside>
    <form class="publishing-form" method="POST" action="/organizer/events" enctype="multipart/form-data" novalidate data-event-draft-form data-event-draft-key="new">
      <%- include('../../partials/csrf-field') %>
      <%- include('../../partials/event-form-fields') %>
      <p class="form-recovery-status" data-draft-recovery-status aria-live="polite">Event details are kept in this browser tab while you work.</p>
      <div class="form-actions"><a class="btn-ghost" href="/organizer/events" data-draft-abandon>Cancel</a><button type="submit">Save draft</button></div>
    </form>
  </main>
  <%- include('../../partials/footer') %>
  <script src="/js/poster-upload.js" defer></script>
  <script src="/js/poster-direct-upload.js" defer></script>
  <script src="/js/event-form-recovery.js" defer></script>
</body>
</html>
