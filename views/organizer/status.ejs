<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg?v=3"><link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=3"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=3"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=3"><link rel="shortcut icon" href="/favicon.ico?v=3"><link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/member-header') %>
  <main class="main-wide organizer-status-page">
    <span class="eyebrow">Organizer workspace</span>
    <h1>Organizer status</h1>
    <p class="muted">Your current authorization and application history.</p>

    <section aria-labelledby="current-organizer-status">
      <h2 id="current-organizer-status" class="cycle-heading"><span>Current cycle</span><span class="cycle-heading__divider" aria-hidden="true">/</span><span class="cycle-heading__value"><%= currentCycle ? currentCycle.name : 'None configured' %></span></h2>

      <% if (effectiveStatus === 'ACTIVE') { %>
        <div class="organizer-state organizer-state--active">
          <div class="organizer-state__heading"><div><span class="organizer-state__label">Authorization granted</span><h2>Approved organizer</h2></div><p class="organizer-state__summary">Ready to publish this cycle</p></div>
          <p>
            Approved Public Name: <strong><%= currentAuthorization.approvedPublicName %></strong>
          </p>
          <p class="helper-text">
            Granted on: <%= new Date(currentAuthorization.grantedAt).toLocaleDateString() %>
          </p>
          <p class="muted">
            Your organizer authorization is active for this cycle. You can create and manage private event drafts.
          </p>
          <div class="actions">
            <a href="/organizer/events" class="btn-primary btn-sm">Manage Event Drafts</a>
          </div>
        </div>
      <% } else if (effectiveStatus === 'PENDING') { %>
        <div class="organizer-state organizer-state--warning">
          <div class="organizer-state__heading"><div><span class="organizer-state__label">Submitted to Management</span><h2>Under review</h2></div><p class="organizer-state__summary">Decision pending</p></div>
          <p>
            Your application for <strong><%= currentPendingApplication.requestedPublicName %></strong> was submitted on <%= new Date(currentPendingApplication.createdAt).toLocaleDateString() %> and is currently under review by YABATECH Management.
          </p>
        </div>
      <% } else if (effectiveStatus === 'REJECTED') { %>
        <div class="organizer-state organizer-state--danger">
          <div class="organizer-state__heading"><div><span class="organizer-state__label">Management decision</span><h2>Application not approved</h2></div><p class="organizer-state__summary">Review the feedback below</p></div>
          <% if (currentLatestApplication && currentLatestApplication.adminReviewNotes) { %>
            <p>
              <strong>Management Review Notes:</strong> <%= currentLatestApplication.adminReviewNotes %>
            </p>
          <% } %>
          <div class="actions">
            <a href="/organizer/apply" class="btn-primary btn-sm">Submit Fresh Application</a>
          </div>
        </div>
      <% } else if (effectiveStatus === 'REVOKED') { %>
        <div class="organizer-state organizer-state--danger">
          <div class="organizer-state__heading"><div><span class="organizer-state__label">Authorization ended</span><h2>Organizer privilege revoked</h2></div><p class="organizer-state__summary">Unavailable this cycle</p></div>
          <p>
            Your organizer authorization for this cycle was revoked on <%= currentAuthorization && currentAuthorization.revokedAt ? new Date(currentAuthorization.revokedAt).toLocaleDateString() : '—' %>.
          </p>
          <% if (currentAuthorization && currentAuthorization.revocationReason) { %>
            <p><strong>Reason:</strong> <%= currentAuthorization.revocationReason %></p>
          <% } %>
          <p class="muted">
            Revocation is final for the current academic cycle. You may reapply in the next academic cycle.
          </p>
        </div>
      <% } else if (effectiveStatus === 'EXPIRED') { %>
        <div class="organizer-state organizer-state--warning">
          <div class="organizer-state__heading"><div><span class="organizer-state__label">Previous-cycle access</span><h2>Authorization expired</h2></div><p class="organizer-state__summary">Renewal required</p></div>
          <p>
            Your organizer authorization has expired with the completion of the academic cycle.
          </p>
          <div class="actions">
            <a href="/organizer/apply" class="btn-primary btn-sm">Apply for Renewal</a>
          </div>
        </div>
      <% } else { %>
        <div class="organizer-state"><div class="organizer-state__heading"><div><span class="organizer-state__label">Organizer access</span><h2>No current application</h2></div><p class="organizer-state__summary">Not requested</p></div><p class="muted">You do not currently hold organizer privileges or have a pending application for this academic cycle.</p>
        <div class="actions">
          <a href="/organizer/apply" class="btn-primary btn-sm">Apply to Become an Organizer</a>
        </div></div>
      <% } %>
    </section>

    <section class="organizer-history" aria-labelledby="application-history">
      <h2 id="application-history">Application history</h2>
      <% if (applicationsHistory && applicationsHistory.length > 0) { %>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Submitted</th>
                <th>Cycle</th>
                <th>Requested Identity</th>
                <th>Status</th>
                <th>Decision Notes</th>
              </tr>
            </thead>
            <tbody>
              <% applicationsHistory.forEach(function(app) { %>
                <tr>
                  <td><%= new Date(app.createdAt).toLocaleDateString() %></td>
                  <td><%= app.cycle ? app.cycle.name : '—' %></td>
                  <td><strong><%= app.requestedPublicName %></strong></td>
                  <td>
                    <span class="application-status application-status--<%= app.status.toLowerCase() %>"><%= app.status === 'PENDING' ? 'Awaiting decision' : app.status.charAt(0) + app.status.slice(1).toLowerCase() %></span>
                  </td>
                  <td class="cell-wrap-clamp"><%= app.adminReviewNotes || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state"><h2>No application history</h2><p>Your previous organizer applications will appear here.</p></div>
      <% } %>
    </section>

    <p class="back-link">
      <a href="/account">&larr; Back to My Account</a>
    </p>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
