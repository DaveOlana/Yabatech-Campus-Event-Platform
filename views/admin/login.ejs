<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>YABATECH Campus Events Platform</h1>
  </header>
  <main>
    <h2>YABATECH Management Sign In</h2>
    <p>Administrative authentication portal for platform oversight.</p>

    <% if (errorMessage) { %>
      <div class="alert-error">
        <%= errorMessage %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" novalidate>
      <div class="form-group">
        <label for="email">Institutional Admin Email</label>
        <input
          type="email"
          id="email"
          name="email"
          value="<%= values.email || '' %>"
          placeholder="admin@ycep.local"
          required
        >
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          required
        >
      </div>

      <button type="submit" class="btn-primary" style="background-color: #0f172a;">Sign In as Administrator</button>
    </form>

    <p style="margin-top: 1.5rem; font-size: 0.9rem;">
      Student or campus member? <a href="/login">Student Sign In</a>
    </p>
    <p style="font-size: 0.9rem;">
      <a href="/">Return to Home</a>
    </p>
  </main>
  <footer>
    <p>&copy; <%= new Date().getFullYear() %> YABATECH Campus Events Platform</p>
  </footer>
</body>
</html>
