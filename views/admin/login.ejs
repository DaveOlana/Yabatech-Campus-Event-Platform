<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png"><link rel="shortcut icon" href="/favicon.ico"><link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <%- include('../partials/admin-login-header') %>
  <main class="auth-panel">
    <div class="auth-heading"><span class="eyebrow">YCEP Management</span><h1>Management sign in</h1><p>Authorized event-management access for YABATECH.</p></div>

    <% if (errorMessage) { %>
      <div class="alert-error">
        <%= errorMessage %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" novalidate>
      <%- include('../partials/csrf-field') %>
      <div class="form-group">
        <label for="username">Management username</label>
        <input
          type="text"
          id="username"
          name="username"
          value="<%= values.username || '' %>"
          autocomplete="username"
          spellcheck="false"
          placeholder="Management username"
          required
        >
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          autocomplete="current-password"
          required
        >
      </div>

      <button type="submit" class="btn-primary btn-block">Sign in</button>
    </form>

    <div class="auth-links"><p><a href="/login">Back to member sign in</a></p></div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
