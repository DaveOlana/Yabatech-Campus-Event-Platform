<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <%- include('../partials/admin-login-header') %>
  <main class="auth-panel">
    <div class="auth-heading"><h1>Management sign in</h1><p>Authenticate to review organizer applications and event proposals.</p></div>

    <% if (errorMessage) { %>
      <div class="alert-error">
        <%= errorMessage %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" novalidate>
      <%- include('../partials/csrf-field') %>
      <div class="form-group">
        <label for="username">Management username</label>
        <input
          type="text"
          id="username"
          name="username"
          value="<%= values.username || '' %>"
          autocomplete="username"
          spellcheck="false"
          placeholder="Management username"
          required
        >
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          autocomplete="current-password"
          required
        >
      </div>

      <button type="submit" class="btn-primary btn-block">Sign in to Management</button>
    </form>

    <div class="auth-links"><p><a href="/">Return to home</a></p></div>
  </main>
  <footer>
    <p>&copy; <%= new Date().getFullYear() %> YABATECH Campus Events Platform</p>
  </footer>
</body>
</html>
