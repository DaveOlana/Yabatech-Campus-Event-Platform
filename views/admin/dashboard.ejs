<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png"><link rel="shortcut icon" href="/favicon.ico"><link rel="stylesheet" href="/css/style.css">
</head>
<body class="management-page">
  <%- include('../partials/admin-header', { activeManagementNav: 'dashboard' }) %>
  <main class="main-wide management-dashboard">
    <div class="page-header"><div><span class="eyebrow">Management workspace</span><h1>Dashboard</h1><p>Platform oversight and privileged operations.</p></div></div>

    <div class="management-summary-grid">
      <section class="card management-summary-card">
        <span class="eyebrow">Identity</span>
        <h2>Management account</h2>
        <dl class="management-facts"><div><dt>Name</dt><dd><%= user.fullName %></dd></div><div><dt>Username</dt><dd><%= user.managementUsername %></dd></div><div><dt>Role</dt><dd><%= user.role %></dd></div></dl>
      </section>
      <section class="card management-summary-card">
        <span class="eyebrow">System</span>
        <h2>Platform status</h2>
        <dl class="management-facts"><div><dt>Database</dt><dd><%= systemStatus.database %></dd></div><div><dt>Academic cycle</dt><dd><%= systemStatus.activeCycle %></dd></div><div><dt>Service</dt><dd>Operational</dd></div></dl>
      </section>
    </div>

    <section class="card management-operations">
      <div><span class="eyebrow">Queues</span><h2>Management operations</h2><p class="muted">Review organizer requests and submitted events.</p></div>
      <div class="actions"><a href="/admin/organizers" class="btn-secondary">Organizer applications</a><a href="/admin/events" class="btn-secondary">Event approvals</a></div>
    </section>

    <section class="card">
      <div class="section-heading"><div><span class="eyebrow">Audit</span><h2>Recent activity</h2></div></div>
      <% if (recentAuditLogs && recentAuditLogs.length > 0) { %>
        <div class="table-container"><table><thead><tr><th>Timestamp</th><th>Action</th><th>Actor</th><th>Target</th></tr></thead><tbody>
          <% recentAuditLogs.forEach(function(log) { %><tr><td><%= new Date(log.createdAt).toLocaleString() %></td><td><code><%= log.action %></code></td><td><%= log.actor ? log.actor.email : log.actorUserId %></td><td><%= log.targetType ? (log.targetType + (log.targetId ? ' #' + log.targetId : '')) : '—' %></td></tr><% }); %>
        </tbody></table></div>
      <% } else { %><div class="empty-state empty-state--compact"><h3>No recent activity</h3><p>Management audit activity will appear here.</p></div><% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
