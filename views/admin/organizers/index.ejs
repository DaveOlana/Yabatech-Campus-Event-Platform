<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>YABATECH Campus Events Platform</h1>
  </header>
  <main class="main-wide">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #e2e8f0; padding-bottom: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h2 style="margin: 0;">Organizer Verification Management</h2>
        <p style="margin: 0.25rem 0 0 0; color: #475569;">
          Review applications and manage organizer authorizations for <strong><%= currentCycle ? currentCycle.name : 'No active cycle' %></strong>
        </p>
      </div>
      <div>
        <a href="/admin" class="btn-secondary btn-sm">Dashboard</a>
      </div>
    </div>

    <% if (errorMessage) { %>
      <div class="alert-error">
        <%= errorMessage %>
      </div>
    <% } %>

    <!-- Pending Applications Section -->
    <section style="margin-bottom: 2rem; padding: 1.25rem; border: 1px solid #e2e8f0; border-radius: 6px;">
      <h3 style="margin-top: 0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
        <span>Actionable Pending Applications (Current Cycle)</span>
        <span class="badge badge-pending">
          <%= pendingApplications.length %> Pending
        </span>
      </h3>

      <% if (pendingApplications && pendingApplications.length > 0) { %>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Submitted</th>
                <th>Applicant</th>
                <th>Matric No</th>
                <th>Department / Level</th>
                <th>Requested Identity</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% pendingApplications.forEach(function(app) { %>
                <tr>
                  <td><%= new Date(app.createdAt).toLocaleDateString() %></td>
                  <td><strong><%= app.user.fullName %></strong></td>
                  <td><code><%= app.user.matricNumber %></code></td>
                  <td>
                    <%= app.user.department ? app.user.department.code : '—' %> / <%= app.user.level ? app.user.level.code : '—' %>
                  </td>
                  <td><strong><%= app.requestedPublicName %></strong></td>
                  <td>
                    <a href="/admin/organizers/<%= app.id %>" class="btn-primary btn-sm">
                      Review Application
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p style="color: #64748b;">No pending organizer applications awaiting review for the current cycle.</p>
      <% } %>
    </section>

    <!-- Active Authorizations Section -->
    <section style="margin-bottom: 2rem; padding: 1.25rem; border: 1px solid #e2e8f0; border-radius: 6px;">
      <h3 style="margin-top: 0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
        <span>Active Authorizations (Current Cycle)</span>
        <span class="badge badge-active">
          <%= activeAuthorizations.length %> Active
        </span>
      </h3>

      <% if (activeAuthorizations && activeAuthorizations.length > 0) { %>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Granted At</th>
                <th>Approved Public Identity</th>
                <th>Member Name</th>
                <th>Matric No</th>
                <th style="min-width: 280px;">Revoke Authority</th>
              </tr>
            </thead>
            <tbody>
              <% activeAuthorizations.forEach(function(auth) { %>
                <tr>
                  <td><%= new Date(auth.grantedAt).toLocaleDateString() %></td>
                  <td><strong><%= auth.approvedPublicName %></strong></td>
                  <td><%= auth.user.fullName %></td>
                  <td><code><%= auth.user.matricNumber %></code></td>
                  <td>
                    <form action="/admin/organizer-authorizations/<%= auth.id %>/revoke" method="POST" style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;" onsubmit="return confirm('Are you sure you want to revoke this organizer authorization? This action is final for the current academic cycle.');">
                      <label for="revocationReason-<%= auth.id %>" class="sr-only">Revocation Reason for <%= auth.approvedPublicName %></label>
                      <input
                        type="text"
                        id="revocationReason-<%= auth.id %>"
                        name="revocationReason"
                        placeholder="Reason for revocation (min 5 chars)..."
                        required
                        minlength="5"
                        maxlength="500"
                        style="padding: 0.4rem 0.6rem; font-size: 0.85rem; min-width: 200px; flex: 1;"
                      >
                      <button type="submit" class="btn-danger btn-sm" style="white-space: nowrap;">
                        Revoke Privilege
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p style="color: #64748b;">No active organizer authorizations currently active in this cycle.</p>
      <% } %>
    </section>

    <p style="margin-top: 1.5rem;">
      <a href="/admin">&larr; Back to Management Console</a>
    </p>
  </main>
  <footer>
    <p>&copy; <%= new Date().getFullYear() %> YABATECH Campus Events Platform</p>
  </footer>
</body>
</html>
