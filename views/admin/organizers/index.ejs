<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg?v=3"><link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=3"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=3"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=3"><link rel="shortcut icon" href="/favicon.ico?v=3"><link rel="stylesheet" href="/css/style.css">
</head>
<body class="management-page">
  <%- include('../../partials/admin-header', { activeManagementNav: 'organizers' }) %>
  <main class="main-wide">
    <div class="page-header">
      <div>
        <span class="eyebrow">Management</span>
        <h1>Organizer applications</h1>
        <p>
          Review applications and manage organizer authorizations for <strong><%= currentCycle ? currentCycle.name : 'No active cycle' %></strong>
        </p>
      </div>
      <div>
        <a href="/admin" class="btn-secondary btn-sm">Dashboard</a>
      </div>
    </div>

    <% if (errorMessage) { %>
      <div class="alert-error">
        <%= errorMessage %>
      </div>
    <% } %>

    <section class="management-section">
      <div class="management-section__heading">
        <div><span class="eyebrow">Current cycle</span><h2>Applications awaiting review</h2></div>
        <div class="queue-metric" aria-label="<%= pendingApplications.length %> applications awaiting review"><strong><%= pendingApplications.length %></strong><span>awaiting review</span></div>
      </div>

      <% if (pendingApplications && pendingApplications.length > 0) { %>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Submitted</th>
                <th>Applicant</th>
                <th>Matric No</th>
                <th>Department / Level</th>
                <th>Requested Identity</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% pendingApplications.forEach(function(app) { %>
                <tr>
                  <td><%= new Date(app.createdAt).toLocaleDateString() %></td>
                  <td><strong><%= app.user.fullName %></strong></td>
                  <td><code><%= app.user.matricNumber %></code></td>
                  <td>
                    <%= app.user.department ? app.user.department.code : '—' %> / <%= app.user.level ? app.user.level.code : '—' %>
                  </td>
                  <td><strong><%= app.requestedPublicName %></strong></td>
                  <td>
                    <a href="/admin/organizers/<%= app.id %>" class="btn-primary btn-sm">
                      Review Application
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="muted">No organizer applications are waiting for review in the current cycle.</p>
      <% } %>
    </section>

    <section class="management-section">
      <div class="management-section__heading">
        <div><span class="eyebrow">Current cycle</span><h2>Authorized organizers</h2></div>
        <div class="queue-metric" aria-label="<%= activeAuthorizations.length %> authorized organizers"><strong><%= activeAuthorizations.length %></strong><span>authorized organizers</span></div>
      </div>

      <% if (activeAuthorizations && activeAuthorizations.length > 0) { %>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Granted At</th>
                <th>Approved Public Identity</th>
                <th>Member Name</th>
                <th>Matric No</th>
                <th style="min-width: 280px;">Revoke Authority</th>
              </tr>
            </thead>
            <tbody>
              <% activeAuthorizations.forEach(function(auth) { %>
                <tr>
                  <td><%= new Date(auth.grantedAt).toLocaleDateString() %></td>
                  <td><strong><%= auth.approvedPublicName %></strong></td>
                  <td><%= auth.user.fullName %></td>
                  <td><code><%= auth.user.matricNumber %></code></td>
                  <td>
                    <form action="/admin/organizer-authorizations/<%= auth.id %>/revoke" method="POST" style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                      <label for="revocationReason-<%= auth.id %>" class="sr-only">Revocation Reason for <%= auth.approvedPublicName %></label>
                      <input
                        type="text"
                        id="revocationReason-<%= auth.id %>"
                        name="revocationReason"
                        placeholder="Reason for revocation (min 5 chars)..."
                        required
                        minlength="5"
                        maxlength="500"
                        style="padding: 0.4rem 0.6rem; font-size: 0.85rem; min-width: 200px; flex: 1;"
                      >
                      <button type="submit" class="btn-danger btn-sm" style="white-space: nowrap;">
                        Revoke Privilege
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="muted">No organizer authorizations are currently available for this cycle.</p>
      <% } %>
    </section>

    <p style="margin-top: 1.5rem;">
      <a href="/admin">&larr; Back to Management Console</a>
    </p>
  </main>
  <%- include('../../partials/footer') %>
</body>
</html>
