<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('../../partials/admin-header') %><main class="container"><p><a href="/admin/events">← Event review</a></p><div class="page-header"><div><span class="badge badge-<%= event.status.toLowerCase().replace('_','-') %>"><%= event.status.replace('_',' ') %></span><h1><%= event.title %></h1><p>Submitted by <strong><%= event.organizerPublicName %></strong> · <%= event.submittedAt?new Date(event.submittedAt).toLocaleString('en-NG'):'Not submitted' %></p></div></div><% if(event.posterUrl){ %><img src="<%= event.posterUrl %>" alt="Poster for <%= event.title %>" style="width:100%;max-height:420px;object-fit:cover;border-radius:14px;margin-bottom:1rem"><% } %><section class="card"><h2>Proposal</h2><p><%= event.description %></p><dl class="detail-grid"><div class="detail-item"><dt>Category</dt><dd><%= event.category.name %></dd></div><div class="detail-item"><dt>Venue</dt><dd><%= event.venue %></dd></div><div class="detail-item"><dt>Date</dt><dd><%= new Date(event.eventDate).toLocaleDateString('en-NG',{dateStyle:'long',timeZone:'UTC'}) %></dd></div><div class="detail-item"><dt>Time</dt><dd><%= event.startTime %>–<%= event.endTime %></dd></div><div class="detail-item"><dt>Recommended departments</dt><dd><%= event.targetDepartments.length?event.targetDepartments.map(td=>td.department.name).join(', '):'All' %></dd></div><div class="detail-item"><dt>Recommended levels</dt><dd><%= event.targetLevels.length?event.targetLevels.map(tl=>tl.level.code).join(', '):'All' %></dd></div></dl><p class="helper-text">Recommended audience supports discovery only and never restricts public visibility.</p></section><% if(organizerTrustWarning){ %><div class="notice notice-warning"><strong>Approval unavailable.</strong> <%= organizerTrustWarning %></div><% } %><% if(event.status==='PENDING_APPROVAL'){ %><section class="card"><h2>Management decision</h2><div class="actions"><% if(organizerTrustValid){ %><form method="POST" action="/admin/events/<%= event.id %>/approve"><button type="submit">Approve and publish</button></form><% } %></div><form method="POST" action="/admin/events/<%= event.id %>/reject" style="margin-top:1.5rem"><div class="form-group"><label for="rejectionReason">Rejection feedback</label><textarea id="rejectionReason" name="rejectionReason" minlength="5" maxlength="500" required aria-describedby="rejectionHelp"></textarea><div id="rejectionHelp" class="helper-text">Explain clearly what Management could not approve.</div></div><button class="btn-danger" type="submit">Reject event</button></form></section><% } %></main><%- include('../../partials/footer') %></body></html>
