<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=2"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=2"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=2"><link rel="shortcut icon" href="/favicon.ico?v=2"><link rel="stylesheet" href="/css/style.css">
</head>
<body class="management-page">
  <%- include('../../partials/admin-header', { activeManagementNav: event.status==='PENDING_APPROVAL' ? 'events' : 'history' }) %>
  <main class="container">
    <p><a href="<%= event.status==='PENDING_APPROVAL'?'/admin/events':'/admin/events/history' %>">&larr; <%= event.status==='PENDING_APPROVAL'?'Event review':'Event history' %></a></p>
    <div class="page-header"><div><span class="badge badge-<%= event.status.toLowerCase().replace('_','-') %>"><%= event.status.replace('_',' ') %></span><h1><%= event.title %></h1><p>Submitted by <strong><%= event.organizerPublicName %></strong> &middot; <%= event.submittedAt?new Date(event.submittedAt).toLocaleString('en-NG'):'Not submitted' %></p></div></div>
    <% if(event.status==='CANCELLED'){ %><div class="notice notice-warning"><h2>Event cancelled</h2><p><%= event.cancellationReason %></p><p>Cancelled <%= event.cancelledAt?new Date(event.cancelledAt).toLocaleString('en-NG'):'—' %><% if(event.cancelledBy){ %> by <%= event.cancelledBy.fullName %> (<%= event.cancelledBy.role %>)<% } %>.</p></div><% } %>
    <% if(event.posterUrl){ %><div class="management-poster-review"><span class="eyebrow">Poster preview</span><div class="poster-frame poster-frame--workflow"><img src="<%= event.posterUrl %>" alt="Poster for <%= event.title %>" class="workflow-poster" referrerpolicy="no-referrer"></div></div><% } else { %><div class="notice"><strong>No poster uploaded.</strong> YCEP fallback artwork will be used publicly.</div><% } %>
    <section class="card">
      <h2>Proposal</h2>
      <p><%= event.description %></p>
      <dl class="detail-grid">
        <div class="detail-item"><dt>Category</dt><dd><%= event.category.name %></dd></div>
        <div class="detail-item"><dt>Venue</dt><dd><%= event.venue %></dd></div>
        <div class="detail-item"><dt>Date</dt><dd><%= new Date(event.eventDate).toLocaleDateString('en-NG',{dateStyle:'long',timeZone:'UTC'}) %></dd></div>
        <div class="detail-item"><dt>Time</dt><dd><%= event.startTime %>&ndash;<%= event.endTime %></dd></div>
        <div class="detail-item"><dt>Registration link</dt><dd><% if(event.registrationUrl){ %><a href="<%= event.registrationUrl %>" target="_blank" rel="noopener noreferrer"><%= event.registrationUrl %> <span aria-hidden="true">&nearr;</span></a><br><span class="helper-text">Inspect this external destination manually before approval.</span><% } else { %>Not provided<% } %></dd></div>
        <div class="detail-item"><dt>Recommended departments</dt><dd><%= event.targetDepartments.length?event.targetDepartments.map(td=>td.department.name).join(', '):'All' %></dd></div>
        <% if(event.suggestedDepartmentName){ %><div class="detail-item"><dt>New department suggestion</dt><dd><strong><%= event.suggestedDepartmentName %> (<%= event.suggestedDepartmentCode %>)</strong><br><span class="helper-text">Approving this event adds it to the official department list and targets this event to it.</span></dd></div><% } %>
        <div class="detail-item"><dt>Recommended levels</dt><dd><%= event.targetLevels.length?event.targetLevels.map(tl=>tl.level.code).join(', '):'All' %></dd></div>
      </dl>
      <p class="helper-text">Recommended audience supports discovery only and never restricts public visibility.</p>
    </section>
    <% if(organizerTrustWarning&&event.status==='PENDING_APPROVAL'){ %><div class="notice notice-warning"><strong>Approval unavailable.</strong> <%= organizerTrustWarning %></div><% } %>
    <% if(event.status==='PENDING_APPROVAL'){ %>
      <section class="card"><h2>Management decision</h2><div class="actions"><% if(organizerTrustValid){ %><form method="POST" action="/admin/events/<%= event.id %>/approve"><button type="submit">Approve and publish</button></form><% } %></div><form method="POST" action="/admin/events/<%= event.id %>/reject" class="spaced-form"><div class="form-group"><label for="rejectionReason">Rejection feedback</label><textarea id="rejectionReason" name="rejectionReason" minlength="5" maxlength="500" required aria-describedby="rejectionHelp"></textarea><div id="rejectionHelp" class="helper-text">Explain clearly what Management could not approve.</div></div><button class="btn-danger" type="submit">Reject event</button></form></section>
    <% } %>
    <% if(event.status==='PUBLISHED'){ %>
      <section class="card cancellation-panel"><h2>Withdraw this event</h2><p class="muted">Withdrawal is permanent. The event leaves discovery, while its direct public page explains the cancellation.</p><form method="POST" action="/admin/events/<%= event.id %>/cancel"><div class="form-group"><label for="cancellationReason">Public withdrawal reason</label><textarea id="cancellationReason" name="cancellationReason" minlength="10" maxlength="500" required aria-describedby="withdrawHelp"></textarea><div id="withdrawHelp" class="helper-text">Use 10–500 characters. Do not include private information.</div></div><button class="btn-danger" type="submit">Withdraw event</button></form></section>
    <% } %>
  </main>
  <%- include('../../partials/footer') %>
</body>
</html>
