<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=2"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=2"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=2"><link rel="shortcut icon" href="/favicon.ico?v=2"><link rel="stylesheet" href="/css/style.css"></head>
<body class="management-page">
  <%- include('../../partials/admin-header', { activeManagementNav: 'events' }) %>
  <main class="main-wide">
    <div class="page-header"><div><span class="eyebrow">Management</span><h1>Event approvals</h1><p>Review submitted proposals in the order they arrived.</p></div><a class="btn-secondary" href="/admin/events/history">Event history</a></div>
    <% if(events.length){ %>
      <div class="table-container"><table><thead><tr><th>Event</th><th>Organizer</th><th>Event date</th><th>Submitted</th><th></th></tr></thead><tbody>
        <% events.forEach(function(event){ %><tr><td><div class="event-review-title"><% if(event.posterUrl){ %><img src="<%= event.posterUrl %>" alt="" class="event-review-thumb" referrerpolicy="no-referrer"><% } %><span><strong><%= event.title %></strong><br><small><%= event.category.name %><%= event.registrationUrl ? ' · Registration link included' : '' %></small></span></div></td><td><%= event.organizerPublicName %></td><td><%= new Date(event.eventDate).toLocaleDateString('en-NG',{timeZone:'UTC'}) %></td><td><%= event.submittedAt?new Date(event.submittedAt).toLocaleString('en-NG'):'—' %></td><td><a class="btn-secondary btn-sm" href="/admin/events/<%= event.id %>">Review</a></td></tr><% }) %>
      </tbody></table></div>
    <% }else{ %><div class="empty-state"><h2>Queue clear</h2><p>There are no event proposals awaiting Management review.</p></div><% } %>
  </main>
  <%- include('../../partials/footer') %>
</body>
</html>
