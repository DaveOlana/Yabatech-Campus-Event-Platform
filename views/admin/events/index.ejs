<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('../../partials/admin-header') %><main class="main-wide"><div class="page-header"><div><h1>Event review</h1><p>Review submitted proposals in the order they arrived.</p></div></div><% if(events.length){ %><div class="table-container"><table><thead><tr><th>Event</th><th>Organizer</th><th>Event date</th><th>Submitted</th><th></th></tr></thead><tbody><% events.forEach(function(event){ %><tr><td><strong><%= event.title %></strong><br><small><%= event.category.name %></small></td><td><%= event.organizerPublicName %></td><td><%= new Date(event.eventDate).toLocaleDateString('en-NG',{timeZone:'UTC'}) %></td><td><%= event.submittedAt?new Date(event.submittedAt).toLocaleString('en-NG'):'—' %></td><td><a class="btn-secondary btn-sm" href="/admin/events/<%= event.id %>">Review</a></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-state"><h2>Queue clear</h2><p>There are no event proposals awaiting Management review.</p></div><% } %></main><%- include('../../partials/footer') %></body></html>
