<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png"><link rel="shortcut icon" href="/favicon.ico"><link rel="stylesheet" href="/css/style.css"></head>
<body class="management-page">
  <%- include('../../partials/admin-header', { activeManagementNav: 'history' }) %>
  <main class="main-wide">
    <div class="page-header"><div><span class="eyebrow">Management</span><h1>Event history</h1><p>Browse reviewed, published, past, and cancelled events.</p></div><a class="btn-secondary" href="/admin/events">Pending queue</a></div>
    <nav class="event-view-tabs" aria-label="Event history views"><% const tabs=[['all','All'],['published','Published'],['rejected','Rejected'],['cancelled','Cancelled'],['past','Past published']]; tabs.forEach(function(tab){ %><a href="<%= tab[0]==='all'?'/admin/events/history':'/admin/events/history?status='+tab[0] %>" class="<%= status===tab[0]?'is-active':'' %>" <%- status===tab[0]?'aria-current="page"':'' %>><%= tab[1] %></a><% }) %></nav>
    <% if(events.length){ %><div class="event-workspace">
      <% events.forEach(function(event){ const timeState=event.status==='PUBLISHED'?getEventTimeState(event.eventDate,event.startTime,event.endTime):null; %>
        <article class="event-row">
          <% if(event.posterUrl){ %><img class="event-row__poster" src="<%= event.posterUrl %>" alt="" referrerpolicy="no-referrer"><% } else { %><div class="event-row__date"><strong><%= new Date(event.eventDate).toLocaleDateString('en-NG',{day:'2-digit',timeZone:'UTC'}) %></strong><span><%= new Date(event.eventDate).toLocaleDateString('en-NG',{month:'short',timeZone:'UTC'}) %></span></div><% } %>
          <div class="event-row__content"><div class="event-row__heading"><div><h2><a href="/admin/events/<%= event.id %>"><%= event.title %></a></h2><p><%= event.organizerPublicName %> &middot; <%= event.category.name %></p></div><div class="event-row__badges"><span class="badge badge-<%= event.status.toLowerCase().replace('_','-') %>"><%= event.status.replace('_',' ') %></span><% if(timeState){ %><span class="time-state time-state--<%= timeState %>"><%= timeState==='past'?'Past event':timeState==='live'?'Happening now':'Upcoming' %></span><% } %></div></div></div>
          <div class="event-row__actions"><a class="btn-secondary btn-sm" href="/admin/events/<%= event.id %>">View</a></div>
        </article>
      <% }) %>
    </div><% }else{ %><div class="empty-state"><h2>No events in this view</h2><p>Try another history filter.</p></div><% } %>
  </main>
  <%- include('../../partials/footer') %>
</body>
</html>
