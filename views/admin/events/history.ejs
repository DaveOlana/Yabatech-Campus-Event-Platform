<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('../../partials/admin-header') %><main class="main-wide"><div class="page-header"><div><span class="eyebrow">Management</span><h1>Event history</h1><p>Browse reviewed, published, past, and cancelled events.</p></div><a class="btn-secondary" href="/admin/events">Pending queue</a></div><nav class="event-view-tabs" aria-label="Event history views"><% const tabs=[['all','All'],['published','Published'],['rejected','Rejected'],['cancelled','Cancelled'],['past','Past published']]; tabs.forEach(function(tab){ %><a href="<%= tab[0]==='all'?'/admin/events/history':'/admin/events/history?status='+tab[0] %>" class="<%= status===tab[0]?'is-active':'' %>" <%- status===tab[0]?'aria-current="page"':'' %>><%= tab[1] %></a><% }) %></nav><% if(events.length){ %><div class="event-workspace"><% events.forEach(function(event){ const dateState=event.status==='PUBLISHED'?getEventDateState(event.eventDate):null; %><article class="event-row"><div class="event-row__date"><strong><%= new Date(event.eventDate).toLocaleDateString('en-NG',{day:'2-digit',timeZone:'UTC'}) %></strong><span><%= new Date(event.eventDate).toLocaleDateString('en-NG',{month:'short',timeZone:'UTC'}) %></span></div><div class="event-row__content"><div class="event-row__heading"><div><h2><a href="/admin/events/<%= event.id %>"><%= event.title %></a></h2><p><%= event.organizerPublicName %> &middot; <%= event.category.name %></p></div><div class="event-row__badges"><span class="badge badge-<%= event.status.toLowerCase().replace('_','-') %>"><%= event.status.replace('_',' ') %></span><% if(dateState){ %><span class="time-state time-state--<%= dateState %>"><%= dateState==='past'?'Past event':dateState.charAt(0).toUpperCase()+dateState.slice(1) %></span><% } %></div></div></div><div class="event-row__actions"><a class="btn-secondary btn-sm" href="/admin/events/<%= event.id %>">View</a></div></article><% }) %></div><% }else{ %><div class="empty-state"><h2>No events in this view</h2><p>Try another history filter.</p></div><% } %></main><%- include('../../partials/footer') %></body></html>
