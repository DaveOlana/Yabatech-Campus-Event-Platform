<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=4"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=4"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=4"><link rel="shortcut icon" href="/favicon.ico?v=4"><link rel="stylesheet" href="/css/style.css">
</head>
<body class="public-discovery">
  <%- include('../partials/public-header') %>
  <main class="public-shell public-detail">
    <p class="public-detail__back"><a href="/">&larr; All events</a></p>
    <% if(event.status === 'CANCELLED') { %>
      <div class="public-cancelled-notice" role="status">
        <span>Cancelled</span>
        <h2>This event has been cancelled.</h2>
        <p><%= event.cancellationReason %></p>
      </div>
    <% } %>
    <article class="public-detail__layout">
      <% if(event.posterUrl && registrationActionable){ %><a class="public-detail__visual public-detail__visual--registration" href="<%= event.registrationUrl %>" target="_blank" rel="noopener noreferrer" aria-label="Register externally for <%= event.title %>"><% } else { %><div class="public-detail__visual"><% } %>
        <% if(event.posterUrl) { %>
          <img src="<%= event.posterUrl %>" alt="Poster for <%= event.title %>" data-poster-image loading="lazy" referrerpolicy="no-referrer">
        <% } %>
        <div class="poster-fallback poster-fallback--detail" data-poster-fallback <%= event.posterUrl ? 'hidden' : '' %>>
          <span><%= event.category.name %></span>
          <strong><%= event.title %></strong>
        </div>
        <% if(event.posterUrl && registrationActionable){ %><span class="poster-registration-cue">Open registration <span aria-hidden="true">&nearr;</span></span><% } %>
      <% if(event.posterUrl && registrationActionable){ %></a><% } else { %></div><% } %>
      <div class="public-detail__content">
        <span class="public-event-card__category"><%= event.category.name %></span>
        <h1><%= event.title %></h1>
        <p class="public-detail__organizer">Presented by <strong><%= event.organizerPublicName %></strong></p>
        <% if(registrationActionable){ %><div class="public-registration-cta"><a class="btn-primary" href="<%= event.registrationUrl %>" target="_blank" rel="noopener noreferrer">Register now <span aria-hidden="true">&nearr;</span></a><p>Registration is handled externally by the event organizer.</p></div><% } else if(event.registrationUrl && event.status === 'PUBLISHED'){ %><p class="registration-closed-note">External registration is no longer available because this event has ended.</p><% } %>
        <div class="public-detail__facts">
          <div><span>Date</span><strong><%= formattedDate %></strong></div>
          <div><span>Time</span><strong><%= formattedTime %> WAT</strong></div>
          <div><span>Venue</span><strong><%= event.venue %></strong></div>
        </div>
        <section class="public-detail__description">
          <h2>About this event</h2>
          <p><%= event.description %></p>
        </section>
        <section class="public-detail__audience">
          <h2>Recommended for</h2>
          <dl>
            <div><dt>Departments</dt><dd><%= event.targetDepartments.length ? event.targetDepartments.map(department => department.name).join(', ') : 'All departments' %></dd></div>
            <div><dt>Levels</dt><dd><%= event.targetLevels.length ? event.targetLevels.map(level => level.code).join(', ') : 'All levels' %></dd></div>
          </dl>
          <p>Recommendations help students discover relevant events. Every published event remains visible to everyone.</p>
        </section>
      </div>
    </article>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
