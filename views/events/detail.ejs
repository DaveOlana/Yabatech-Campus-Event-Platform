<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head><body class="public-discovery"><%- include('../partials/public-header') %><main class="public-shell public-detail"><p class="public-detail__back"><a href="/">← All events</a></p><article class="public-detail__layout"><div class="public-detail__visual"><% if(event.posterUrl){ %><img src="<%= event.posterUrl %>" alt="Poster for <%= event.title %>" data-poster-image><% } %><div class="poster-fallback poster-fallback--detail" data-poster-fallback <%= event.posterUrl ? 'hidden' : '' %>><span><%= event.category.name %></span><strong><%= event.title %></strong></div></div><div class="public-detail__content"><span class="public-event-card__category"><%= event.category.name %></span><h1><%= event.title %></h1><p class="public-detail__organizer">Presented by <strong><%= event.organizerPublicName %></strong></p><div class="public-detail__facts"><div><span>Date</span><strong><%= formattedDate %></strong></div><div><span>Time</span><strong><%= formattedTime %> WAT</strong></div><div><span>Venue</span><strong><%= event.venue %></strong></div></div><section class="public-detail__description"><h2>About this event</h2><p><%= event.description %></p></section><section class="public-detail__audience"><h2>Recommended for</h2><dl><div><dt>Departments</dt><dd><%= event.targetDepartments.length ? event.targetDepartments.map(department => department.name).join(', ') : 'All departments' %></dd></div><div><dt>Levels</dt><dd><%= event.targetLevels.length ? event.targetLevels.map(level => level.code).join(', ') : 'All levels' %></dd></div></dl><p>Recommendations help students discover relevant events. Every published event remains visible to everyone.</p></section></div></article></main><%- include('../partials/footer') %><script>document.querySelectorAll('[data-poster-image]').forEach(function(image){image.addEventListener('error',function(){this.hidden=true;var fallback=this.parentElement.querySelector('[data-poster-fallback]');if(fallback)fallback.hidden=false;});});</script></body></html>
