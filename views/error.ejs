<% const normalizedTitle = (title || '').toLowerCase(); const isForbidden = normalizedTitle.includes('forbidden'); const isNotFound = normalizedTitle.includes('not found'); %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg?v=3"><link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=3"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=3"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=3"><link rel="shortcut icon" href="/favicon.ico?v=3"><link rel="stylesheet" href="/css/style.css"></head><body><%- include('partials/public-header') %><main class="state-page"><div class="state-code" aria-hidden="true"><%= isForbidden ? '403' : isNotFound ? '404' : '!' %></div><h1><%= isForbidden ? 'Access restricted' : isNotFound ? 'Event not found' : 'Something needs attention' %></h1><p><%= message %></p><div class="form-actions"><% if(typeof returnUrl !== 'undefined' && returnUrl){ %><a href="<%= returnUrl %>" class="btn-secondary"><%= typeof returnLabel !== 'undefined' && returnLabel ? returnLabel : 'Go back' %></a><% } %><a href="/" class="btn-ghost">Return home</a></div></main><%- include('partials/footer') %></body></html>
