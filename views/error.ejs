<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('partials/public-header') %><main class="state-page"><div class="state-code" aria-hidden="true"><%= title && title.toLowerCase().includes('forbidden') ? '403' : '!' %></div><h1><%= title && title.toLowerCase().includes('forbidden') ? 'Access restricted' : 'Something needs attention' %></h1><p><%= message %></p><a href="/" class="btn-secondary">Return home</a></main><%- include('partials/footer') %></body></html>
