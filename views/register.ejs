<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg?v=3"><link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=3"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=3"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=3"><link rel="shortcut icon" href="/favicon.ico?v=3"><link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page auth-page--register">
  <%- include('partials/public-header') %>
  <main class="auth-panel auth-panel--wide">
    <div class="auth-heading"><h1>Create your account</h1><p>Join YCEP with your YABATECH student identity. Current-cycle verification is granted automatically.</p></div>

    <% if (errorMessage) { %>
      <div class="alert-error">
        <%= errorMessage %>
      </div>
    <% } %>

    <form action="/register" method="POST" novalidate id="registerForm">
      <%- include('partials/csrf-field') %>
      <div class="form-group">
        <label for="fullName">Full Name</label>
        <input
          type="text"
          id="fullName"
          name="fullName"
          value="<%= values.fullName || '' %>"
          class="<%= errors.fullName ? 'input-error' : '' %>"
          autocomplete="name"
          placeholder="e.g. David Olana"
          required
        >
        <% if (errors.fullName) { %>
          <div class="field-error"><%= errors.fullName[0] %></div>
        <% } %>
      </div>

      <div class="form-group">
        <label for="matricNumber">Matric Number</label>
        <input
          type="text"
          id="matricNumber"
          name="matricNumber"
          value="<%= values.matricNumber || '' %>"
          class="<%= errors.matricNumber ? 'input-error' : '' %>"
          autocomplete="username"
          autocapitalize="characters"
          spellcheck="false"
          placeholder="e.g. F/ND/24/3210051"
          required
        >
        <div class="helper-text">Format: PREFIX/PROGRAMME/YY/SERIAL (e.g. F/ND/24/3210051, PT/HND/25/2100001)</div>
        <% if (errors.matricNumber) { %>
          <div class="field-error"><%= errors.matricNumber[0] %></div>
        <% } %>
      </div>

      <div class="form-group">
        <label for="email">Email Address</label>
        <input
          type="email"
          id="email"
          name="email"
          value="<%= values.email || '' %>"
          class="<%= errors.email ? 'input-error' : '' %>"
          autocomplete="email"
          placeholder="student@example.com"
          required
        >
        <% if (errors.email) { %>
          <div class="field-error"><%= errors.email[0] %></div>
        <% } %>
      </div>

      <div class="form-group">
        <label for="departmentId">Department</label>
        <%- include('partials/department-picker', { id: 'departmentId', name: 'departmentId', departments, valueKey: 'id', selectedValue: values.departmentId, placeholder: 'Select department', searchPlaceholder: 'Search by department name', multiple: false, required: true, showCode: true, errorClass: errors.departmentId ? 'input-error' : '' }) %>
        <% if (errors.departmentId) { %>
          <div class="field-error"><%= errors.departmentId[0] %></div>
        <% } %>
      </div>

      <div class="form-group">
        <label for="levelId">Level</label>
        <select
          id="levelId"
          name="levelId"
          class="<%= errors.levelId ? 'input-error' : '' %>"
          required
        >
          <option value="">-- Select Level --</option>
          <% levels.forEach(lvl => { %>
            <option
              value="<%= lvl.id %>"
              <%= values.levelId === lvl.id ? 'selected' : '' %>
            >
              <%= lvl.code %> — <%= lvl.label %>
            </option>
          <% }); %>
        </select>
        <% if (errors.levelId) { %>
          <div class="field-error"><%= errors.levelId[0] %></div>
        <% } %>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          class="<%= errors.password ? 'input-error' : '' %>"
          autocomplete="new-password"
          required
        >
        <div class="helper-text">Minimum 8 characters</div>
        <% if (errors.password) { %>
          <div class="field-error"><%= errors.password[0] %></div>
        <% } %>
      </div>

      <div class="form-group">
        <label for="passwordConfirmation">Confirm Password</label>
        <input
          type="password"
          id="passwordConfirmation"
          name="passwordConfirmation"
          class="<%= errors.passwordConfirmation ? 'input-error' : '' %>"
          autocomplete="new-password"
          required
        >
        <% if (errors.passwordConfirmation) { %>
          <div class="field-error"><%= errors.passwordConfirmation[0] %></div>
        <% } %>
      </div>

      <button type="submit" class="btn-primary btn-block">Register</button>
    </form>

    <script src="/js/registration-form.js" defer></script>

    <div class="auth-links"><p>Already a member? <a href="/login">Sign in</a></p><p><a href="/">Return to home</a></p></div>
  </main>
  <footer>
    <p>&copy; <%= new Date().getFullYear() %> YABATECH Campus Events Platform</p>
  </footer>
</body>
</html>
