<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('partials/member-header') %><main class="container">
<div class="page-header"><div><h1>My account</h1><p>Your YCEP identity and current academic verification.</p></div></div>
<section class="card"><div class="page-header"><div><h2><%= user.fullName %></h2><p><%= user.email %></p></div><span class="badge <%= currentVerification && currentVerification.status === 'ACTIVE' ? 'badge-active' : 'badge-expired' %>"><%= user.role === 'ADMIN' ? 'Management' : currentVerification ? currentVerification.status : 'Unverified' %></span></div><dl class="detail-grid"><div class="detail-item"><dt>Matric number</dt><dd><%= user.matricNumber || '—' %></dd></div><div class="detail-item"><dt>Role</dt><dd><%= user.role %></dd></div><% if(user.department){ %><div class="detail-item"><dt>Department</dt><dd><%= user.department.name %> (<%= user.department.code %>)</dd></div><% } %><% if(user.level){ %><div class="detail-item"><dt>Level</dt><dd><%= user.level.code %> — <%= user.level.label %></dd></div><% } %><div class="detail-item"><dt>Academic cycle</dt><dd><%= currentCycle ? currentCycle.name : 'None configured' %></dd></div><% if(currentVerification && currentVerification.expiresAt){ %><div class="detail-item"><dt>Verification expires</dt><dd><%= new Date(currentVerification.expiresAt).toLocaleDateString('en-NG') %></dd></div><% } %></dl></section>
<% if(user.role==='MEMBER'){ %><section class="card"><h2>Organizer workspace</h2><p class="muted">Apply for organizer privileges, review your current status, or manage event proposals after approval.</p><div class="actions"><a href="/organizer/status" class="btn-secondary">Organizer status</a><a href="/organizer/apply" class="btn-ghost">Apply for privileges</a></div></section><% } %>
</main><%- include('partials/footer') %></body></html>
