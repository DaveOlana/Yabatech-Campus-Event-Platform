<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/member-header') %>
  <main class="container">
    <div class="page-header"><div><h1>My account</h1><p>Your YCEP identity and current academic verification.</p></div></div>
    <section class="card account-summary">
      <div class="account-summary__head">
        <div><h2><%= user.fullName %></h2><p class="muted"><%= user.email %></p></div>
        <div class="account-summary__controls"><a class="btn-secondary btn-sm" href="/account/edit">Edit details</a></div>
      </div>
      <dl class="detail-grid account-summary__details">
        <div class="detail-item"><dt>Matric number</dt><dd><%= user.matricNumber || '—' %></dd></div>
        <div class="detail-item"><dt>Role</dt><dd><%= user.role %></dd></div>
        <% if(user.department){ %><div class="detail-item"><dt>Department</dt><dd><%= user.department.name %> (<%= user.department.code %>)</dd></div><% } %>
        <% if(user.level){ %><div class="detail-item"><dt>Level</dt><dd><%= user.level.code %> — <%= user.level.label %></dd></div><% } %>
        <div class="detail-item"><dt>Academic cycle</dt><dd><%= currentCycle ? currentCycle.name : 'None configured' %></dd></div>
        <div class="detail-item"><dt>Verification status</dt><dd><%= currentVerification ? currentVerification.status : 'Unverified' %></dd></div>
        <% if(currentVerification && currentVerification.expiresAt){ %><div class="detail-item"><dt>Verification expires</dt><dd><%= new Date(currentVerification.expiresAt).toLocaleDateString('en-NG') %></dd></div><% } %>
      </dl>
      <% if(user.role==='MEMBER'){ %>
        <div class="account-actions">
          <h2>Organizer workspace</h2>
          <p class="muted">Review your organizer status or apply for privileges to propose campus events.</p>
          <div class="actions"><a href="/organizer/status" class="btn-secondary">View organizer status</a><a href="/organizer/apply" class="btn-ghost">Apply for privileges</a></div>
        </div>
        <div class="management-access">
          <div><h2>Management access</h2><p class="muted">For authorized YABATECH event-management personnel.</p></div>
          <a class="btn-secondary" href="/admin/login">Management sign in</a>
        </div>
      <% } %>
    </section>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
