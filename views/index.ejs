<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png?v=2"><link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png?v=2"><link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=2"><link rel="shortcut icon" href="/favicon.ico?v=2"><link rel="stylesheet" href="/css/style.css"></head>
<body class="public-discovery">
<%- include('partials/public-header') %>
<main class="public-shell">
  <section class="discovery-hero">
    <h1>Campus life,<br><span>all in one place.</span></h1>
    <p>Discover talks, workshops, career opportunities and campus experiences—all reviewed by YABATECH Management.</p>
    <div class="hero-actions"><a class="btn-primary" href="#upcoming-events">Explore events</a><a class="btn-ghost" href="/about">How YCEP works <span aria-hidden="true">&rarr;</span></a></div>
  </section>

  <form class="discovery-filters <%= hasActiveFilters ? 'has-active-filters' : '' %>" method="get" action="/" role="search" aria-label="Search and filter campus events">
    <div class="discovery-search">
      <label for="event-search">Search events</label>
      <div class="discovery-search__row"><input id="event-search" name="q" type="search" maxlength="100" value="<%= filters.q %>" placeholder="Title, venue, organizer, or keyword"><button type="submit">Search</button></div>
    </div>
    <div class="discovery-filter-grid">
      <div><label for="category-filter">Category</label><select id="category-filter" name="category"><option value="">All categories</option><% filterOptions.categories.forEach(function(option){ %><option value="<%= option.code %>" <%= filters.category === option.code ? 'selected' : '' %>><%= option.name %></option><% }) %></select></div>
      <div><label for="department-filter">Department</label><%- include('partials/department-picker', { id: 'department-filter', name: 'department', departments: filterOptions.departments, valueKey: 'code', selectedValue: filters.department, placeholder: 'All departments', searchPlaceholder: 'Search departments', multiple: false, required: false, showCode: false, errorClass: '' }) %></div>
      <div><label for="level-filter">Level</label><select id="level-filter" name="level"><option value="">All levels</option><% filterOptions.levels.forEach(function(option){ %><option value="<%= option.code %>" <%= filters.level === option.code ? 'selected' : '' %>><%= option.label %></option><% }) %></select></div>
      <div><label for="date-filter">Date</label><select id="date-filter" name="date"><option value="upcoming" <%= filters.date === 'upcoming' ? 'selected' : '' %>>All upcoming</option><option value="today" <%= filters.date === 'today' ? 'selected' : '' %>>Today</option><option value="week" <%= filters.date === 'week' ? 'selected' : '' %>>This week</option><option value="month" <%= filters.date === 'month' ? 'selected' : '' %>>This month</option></select></div>
      <div class="discovery-filter-actions"><button type="submit" class="btn-secondary">Apply filters</button><% if(hasActiveFilters){ %><a href="/" class="clear-filters">Clear filters</a><% } %></div>
    </div>
    <p class="discovery-filter-help">Department and level indicate relevance only. General campus events are included.</p>
  </form>

  <% if(invalidFilters){ %><p class="public-filter-notice" role="status">Some filters were not recognized. <a href="/">Clear filters</a></p><% } %>

  <section class="events-section" aria-labelledby="upcoming-events">
    <div class="section-heading"><div><span class="eyebrow">Campus calendar</span><h2 id="upcoming-events">Upcoming events</h2><p class="result-summary"><% if(total === 0 && hasActiveFilters){ %>No matching events<% } else if(total > limit){ %>Showing <%= events.length %> of <%= total %> events<% } else { %><%= total %> <%= total === 1 ? 'event' : 'events' %><% } %></p></div></div>
    <% if(events.length){ %><div class="public-event-grid"><% events.forEach(function(event){ %><%- include('partials/public-event-card',{event,formatEventCardDate,formatEventTimeRange}) %><% }) %></div>
    <% }else if(hasActiveFilters){ %><div class="public-empty-state"><div class="public-empty-state__mark" aria-hidden="true">Y</div><h2>No events match your search.</h2><p>Try changing your search or clearing the filters.</p><a class="btn-secondary" href="/">Clear filters</a></div>
    <% }else{ %><div class="public-empty-state"><div class="public-empty-state__mark" aria-hidden="true">Y</div><h2>No upcoming events yet.</h2><p>Check back soon for newly approved campus events.</p></div><% } %>
  </section>
</main>
<%- include('partials/footer') %>
</body></html>
