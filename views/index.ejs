<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head><body class="public-discovery"><%- include('partials/public-header') %><main class="public-shell"><section class="discovery-hero"><span class="eyebrow">YABATECH campus events</span><h1>Discover what’s happening<br>around YABATECH.</h1><p>Talks, workshops, career opportunities, social activities, and campus experiences—approved by YABATECH Management.</p></section><section class="events-section" aria-labelledby="upcoming-events"><div class="section-heading"><div><span class="eyebrow">Campus calendar</span><h2 id="upcoming-events">Upcoming events</h2></div><p><%= events.length %> <%= events.length === 1 ? 'event' : 'events' %></p></div><% if(events.length){ %><div class="public-event-grid"><% events.forEach(function(event){ %><%- include('partials/public-event-card',{event,formatEventCardDate,formatEventTimeRange}) %><% }) %></div><% }else{ %><div class="public-empty-state"><div class="public-empty-state__mark" aria-hidden="true">Y</div><h2>No upcoming events yet.</h2><p>Check back soon for newly approved campus events.</p></div><% } %></section></main><%- include('partials/footer') %><script>document.querySelectorAll('[data-poster-image]').forEach(function(image){image.addEventListener('error',function(){this.hidden=true;var fallback=this.parentElement.querySelector('[data-poster-fallback]');if(fallback)fallback.hidden=false;});});</script></body></html>
