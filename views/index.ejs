<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>YABATECH Campus Events Platform (YCEP)</h1>
  </header>
  <main>
    <section>
      <h2>System Status</h2>
      <p>Platform: <strong><%= status %></strong></p>
      <p>Version: <strong><%= version %></strong></p>
      <p>Campus event discovery, registration, management, and attendance platform.</p>
      <div style="margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/register" class="btn-primary" style="max-width: 200px;">Register as Member</a>
        <a href="/login" class="btn-secondary" style="max-width: 150px;">Sign In</a>
      </div>
    </section>
  </main>
  <footer>
    <p>&copy; <%= new Date().getFullYear() %> YABATECH Campus Events Platform</p>
  </footer>
</body>
</html>
