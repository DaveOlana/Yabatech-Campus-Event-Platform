generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

/// User role within the platform.
/// MEMBER is the default role. ADMIN represents YABATECH Management.
/// Organizer is NOT a User role — it is a separate approved capability.
enum UserRole {
  MEMBER
  ADMIN
}

/// Verification status for a member within an academic cycle.
enum VerificationStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// Predefined academic levels at YABATECH.
enum LevelCode {
  ND1
  ND2
  HND1
  HND2
}

/// Status of an organizer application submitted by a member.
enum OrganizerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Status of an organizer authorization granted to a member for an academic cycle.
enum OrganizerAuthorizationStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

/// Lifecycle state of an event.
/// Milestone 4A operates exclusively with DRAFT.
enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  COMPLETED
  REJECTED
  CANCELLED
}

// ─── Department ───────────────────────────────────────────────────────────────

/// Academic department at YABATECH.
/// Name and code are unique to prevent duplicates.
model Department {
  id        String   @id @default(uuid())
  name      String   @unique /// e.g. "Computer Science"
  code      String   @unique /// e.g. "CSC"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  targetEvents EventTargetDepartment[]
}

// ─── Level ────────────────────────────────────────────────────────────────────

/// Academic level. Seeded with ND1, ND2, HND1, HND2.
/// Uses the LevelCode enum to prevent arbitrary values.
model Level {
  id        String    @id @default(uuid())
  code      LevelCode @unique
  label     String    /// Human-readable label, e.g. "National Diploma Year 1"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users        User[]
  targetEvents EventTargetLevel[]
}

// ─── AcademicYearCycle ────────────────────────────────────────────────────────

/// Represents a yearly academic cycle (e.g. "2025/2026").
/// At most one cycle may have isCurrent = true at any time.
/// This invariant is enforced via a PostgreSQL partial unique index
/// added manually to the migration SQL:
///   CREATE UNIQUE INDEX "AcademicYearCycle_one_current"
///   ON "AcademicYearCycle" ("isCurrent") WHERE "isCurrent" = true;
model AcademicYearCycle {
  id        String   @id @default(uuid())
  name      String   @unique /// e.g. "2025/2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifications           MemberVerification[]
  organizerApplications   OrganizerApplication[]
  organizerAuthorizations OrganizerAuthorization[]
}

// ─── User ─────────────────────────────────────────────────────────────────────

/// A YCEP account. May be a normal MEMBER or an ADMIN.
/// Organizer capability is handled separately via OrganizerAuthorization.
model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  matricNumber String?  @unique @map("matric_number")
  passwordHash String   @map("password_hash")
  role         UserRole @default(MEMBER)

  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  levelId String? @map("level_id")
  level   Level?  @relation(fields: [levelId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifications                 MemberVerification[]
  auditLogs                     AuditLog[]
  organizerApplications         OrganizerApplication[]   @relation("ApplicantOrganizerApplications")
  reviewedOrganizerApplications OrganizerApplication[]   @relation("ReviewedOrganizerApplications")
  organizerAuthorizations       OrganizerAuthorization[]
}

// ─── MemberVerification ───────────────────────────────────────────────────────

/// Records a member's verification status for a specific academic cycle.
/// Only one verification record per user per cycle (enforced by unique constraint).
/// Expiring verification never deletes the User account.
model MemberVerification {
  id     String             @id @default(uuid())
  status VerificationStatus @default(ACTIVE)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  cycleId String            @map("cycle_id")
  cycle   AcademicYearCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  verifiedAt DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Only one verification per user per cycle.
  @@unique([userId, cycleId])
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────

/// Immutable audit record for administrative and privileged operations.
/// Actor relation uses onDelete: Restrict to prevent cascade-deleting audit history.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String   @map("actor_user_id")
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String   /// e.g. "ADMIN_LOGIN", "ADMIN_LOGOUT"
  targetType  String?  @map("target_type") /// Optional target entity type
  targetId    String?  @map("target_id")   /// Optional target entity ID
  metadata    Json?    /// Structured metadata (never stores sensitive auth details)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

// ─── OrganizerApplication ─────────────────────────────────────────────────────

/// Historical record of a member's application to receive organizer privileges
/// for a specific academic cycle.
model OrganizerApplication {
  id                  String                     @id @default(uuid())
  userId              String                     @map("user_id")
  user                User                       @relation("ApplicantOrganizerApplications", fields: [userId], references: [id], onDelete: Restrict)
  cycleId             String                     @map("cycle_id")
  cycle               AcademicYearCycle          @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  requestedPublicName String                     @map("requested_public_name")
  phoneNumber         String                     @map("phone_number")
  organizationName    String?                    @map("organization_name")
  positionTitle       String?                    @map("position_title")
  reason              String
  evidenceUrlOrText   String?                    @map("evidence_url_or_text")
  status              OrganizerApplicationStatus @default(PENDING)
  adminReviewNotes    String?                    @map("admin_review_notes")
  reviewedAt          DateTime?                  @map("reviewed_at")
  reviewerUserId      String?                    @map("reviewer_user_id")
  reviewer            User?                      @relation("ReviewedOrganizerApplications", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  authorization OrganizerAuthorization?

  @@index([userId])
  @@index([cycleId])
  @@index([status])
  @@index([createdAt])
}

// ─── OrganizerAuthorization ───────────────────────────────────────────────────

/// Cycle-bound organizer capability granted by YABATECH Management to an active MEMBER.
/// Only one authorization per member per academic cycle.
model OrganizerAuthorization {
  id                 String                       @id @default(uuid())
  userId             String                       @map("user_id")
  user               User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  cycleId            String                       @map("cycle_id")
  cycle              AcademicYearCycle            @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  applicationId      String                       @unique @map("application_id")
  application        OrganizerApplication         @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  approvedPublicName String                       @map("approved_public_name")
  status             OrganizerAuthorizationStatus @default(ACTIVE)
  grantedAt          DateTime                     @default(now()) @map("granted_at")
  revokedAt          DateTime?                    @map("revoked_at")
  revocationReason   String?                      @map("revocation_reason")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  events             Event[]                      @relation("OrganizerEvents")

  @@unique([userId, cycleId])
  @@index([userId])
  @@index([cycleId])
  @@index([status])
}

// ─── EventCategory ────────────────────────────────────────────────────────────

/// Configurable campus event category.
model EventCategory {
  id          String   @id @default(uuid())
  name        String   @unique /// e.g. "Academic", "Workshop", "Technology"
  code        String   @unique /// e.g. "ACADEMIC", "WORKSHOP", "TECH"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  events Event[]
}

// ─── Event ────────────────────────────────────────────────────────────────────

/// Primary campus event model.
/// Cycle-bound ownership is enforced via primaryOrganizerAuthorizationId.
/// An event's academic cycle is derived directly through its organizer authorization.
model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  posterUrl   String?  @map("poster_url")

  categoryId String        @map("category_id")
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  eventDate DateTime @map("event_date") @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  venue     String

  primaryOrganizerAuthorizationId String                 @map("primary_organizer_authorization_id")
  primaryOrganizerAuthorization   OrganizerAuthorization @relation("OrganizerEvents", fields: [primaryOrganizerAuthorizationId], references: [id], onDelete: Restrict)

  organizerPublicName String @map("organizer_public_name")

  status EventStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  targetDepartments EventTargetDepartment[]
  targetLevels      EventTargetLevel[]

  @@index([primaryOrganizerAuthorizationId])
  @@index([categoryId])
  @@index([status])
  @@index([eventDate])
}

// ─── EventTargetDepartment ────────────────────────────────────────────────────

/// Recommended discovery audience: Department(s). Does not restrict public visibility.
model EventTargetDepartment {
  id           String     @id @default(uuid())
  eventId      String     @map("event_id")
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([eventId, departmentId])
  @@index([eventId])
  @@index([departmentId])
}

// ─── EventTargetLevel ─────────────────────────────────────────────────────────

/// Recommended discovery audience: Level(s). Does not restrict public visibility.
model EventTargetLevel {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  levelId   String   @map("level_id")
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, levelId])
  @@index([eventId])
  @@index([levelId])
}
